# Copy to .env and fill in. Never commit .env.

# Postgres (docker-compose wires DATABASE_URL from these)
POSTGRES_DB=dao
POSTGRES_USER=dao
POSTGRES_PASSWORD=change-me

# Where the app listens on the host. Put a reverse proxy (Caddy/nginx) in front for TLS.
BIND_ADDR=127.0.0.1
APP_PORT=8000

# Addresses allowed to set X-Forwarded-For (the proxy, as the container sees it). Default is the Docker bridge
# range, which is where a proxy on the host arrives from. If the proxy runs elsewhere, put its address here.
# FORWARDED_ALLOW_IPS=172.16.0.0/12

# The XE node this instance reads from and submits to.
#   testnet: https://ldn.core.test.network
#   mainnet: set at Genesis
XE_NODE_URL=https://ldn.core.test.network

# The public URL this instance is served at. Reported in GET /v1 and used in the identifier.
#   testnet: https://dao.test.network
#   mainnet: https://dao.xe.network
PUBLIC_BASE_URL=https://dao.test.network

# Config directory (Schedule B/C, registry, charter, copy). Mounted read-only in compose.
DAO_CONFIG_DIR=/app/config

# Signer keyfile (encrypted with DAO_SIGNER_PASSPHRASE). Create with: dao keys init
DAO_SIGNER_KEYFILE=/app/secrets/signer.json
DAO_SIGNER_PASSPHRASE=change-me-too

# Optional: libp2p peer id of the node the DAO account is reachable on for chat (defaults to XE_NODE_URL's /node id)
# DAO_DIRECTORY_NODE_PEER=

# Build metadata (set by the deploy script)
GIT_COMMIT=unknown

LOG_LEVEL=info
